<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext HTTP is allowed ONLY for the in-process NanoHTTPD tile server bound to the
  loopback interface (TileSourceMode.BUNDLED). Everything else must be HTTPS, which limits
  the app's only real network use to the first-run offline pack download.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
